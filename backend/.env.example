# MongoDB connection string. Leave unset to run with in-memory storage only.
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive-tutor

# Google AI Studio API key (https://aistudio.google.com/apikey).
# Leave unset to get deterministic placeholder hints instead of Gemini output.
GEMINI_API_KEY=

# Optional overrides (defaults shown).
# PORT=5000
# HOST=127.0.0.1
# ML_SERVICE_URL=http://127.0.0.1:8000
# GEMINI_MODEL=gemini-3.5-flash
